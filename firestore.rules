rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // staff または admin のみアクティブユーザーとして扱う
    function isApproved() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['staff', 'admin'];
    }

    match /users/{userId} {
      allow read: if request.auth.uid == userId || isAdmin();
      allow create: if request.auth.uid == userId && request.resource.data.role == 'pending';
      allow update: if isAdmin() || (
        request.auth.uid == userId &&
        request.resource.data.role == resource.data.role
      );
      allow delete: if isAdmin();
    }

    match /submissions/{docId} {
      allow read: if isApproved();
      allow create: if (isApproved() &&
        request.resource.data.staffId == request.auth.uid) || isAdmin();
      allow update: if (isApproved() &&
        resource.data.staffId == request.auth.uid &&
        request.resource.data.staffId == request.auth.uid) || isAdmin();
      allow delete: if isAdmin();
    }

    match /adminOverrides/{yearMonth} {
      allow read: if isApproved();
      allow write: if isAdmin();
    }

    match /attendance/{recordId} {
      allow read: if isApproved();
      allow create: if isAdmin() || (isApproved() &&
        request.resource.data.userId == request.auth.uid);
      allow update: if isAdmin();
    }

    match /staffStats/{staffId} {
      allow read: if request.auth.uid == staffId || isAdmin();
      allow write: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if isApproved();
      allow write: if isAdmin();
    }

    match /notifications/{staffId} {
      allow read: if request.auth.uid == staffId || isAdmin();
      allow create, update: if isAdmin();
      allow delete: if request.auth.uid == staffId || isAdmin();
    }
  }
}
